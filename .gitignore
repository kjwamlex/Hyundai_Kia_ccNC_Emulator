# Publish only project sources and documentation. Firmware stays local.
/*
!/.gitignore
!/README.md
!/NOTICE.md
!/.github/
!/qemu/
!/docs/

.DS_Store
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.img
*.bin
*.dtb
*.qcow2
*.raw
*.cpio
*.cpio.gz
*.apk
*.deb
*.zip
*.so
*.so.*
*.wav
*.mp3
*.mp4
*.264
*.png
*.jpg

# Explicitly approved README screenshots; other image assets remain excluded.
!/docs/screenshots/dashboard.png
!/docs/screenshots/software-info.png
!/docs/screenshots/kia-dashboard.png
!/docs/screenshots/kia-software-info.png
